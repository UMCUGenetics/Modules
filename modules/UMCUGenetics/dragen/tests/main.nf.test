nextflow_process {

    name "Test Process DRAGEN"
    script "../main.nf"
    process "DRAGEN"

    tag "modules"
    tag "modules_UMCUGenetics"
    tag "dragen"

    test("dragen - stub") {
        options '-stub'
        when {
            process {
                """
                input[0] = [
                    [id:'sample1'],
                    [],
                    []
                ]
                input[1] = []
                input[2] = []
                input[3] = []
                """
            }
        }
        then {
            assertAll(
                { assert process.success },
                { assert snapshot(
                    process.out,
                    process.out.findAll { key, val -> key.startsWith('versions') }
                ).match() }
            )
        }
    }
}
