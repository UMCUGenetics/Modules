nextflow_process {
    name "Test ICA_UNTAR_GENOME_BUNDLE module"
    script "../main.nf"
    process "ICA_UNTAR_GENOME_BUNDLE"

    tag "modules"
    tag "modules_UMCUGenetics"
    tag "modules/ica_untar_genome_bundle"
    tag "ica/untar_genome_bundle"
    tag "untar_genome_bundle"

    test("Validate ica untar genome bundle") {
        when {
            process{
                """
                input[0] = channel.of([
                    [id: 'genome'],
                    file(params.subworkflows_umcu_testdata_base_path + "prepare_ica_references/genome.tar.gz", checkIfExists: true)
                ])
                """
            }
        }
        then{
            assertAll(
                { assert process.success },
                { assert path(process.out.dragen_ref[0][1]).exists() },
                { assert path(process.out.fasta[0][1]).exists() },
                { assert path(process.out.gtf[0][1]).exists() },
                { assert snapshot(
                    process.out.findAll { key, val -> key.startsWith('versions') }
                ).match() }
            )
        }
    }
}
