nextflow_process {
    name "Test UNTAR_GENOME module"
    script "../main.nf"
    process "UNTAR_GENOME"

    tag "modules"
    tag "modules_UMCUGenetics"
    tag "modules/untar_genome"
    tag "untar/genome"
    tag "untar"

    test("Validate genome untar") {
        when {
            process{
                """
                input[0] = channel.of([
                    [id: 'genome'],
                    file(params.subworkflows_umcu_testdata_base_path + "prepare_ica_references/genome.tar", checkIfExists: true)
                ])
                """
            }
        }
        then{
            assertAll(
                { assert process.success },
                { assert snapshot(
                    process.out.findAll { key, val -> key.startsWith('versions') }
                ).match() }
            )
        }
    }
}
